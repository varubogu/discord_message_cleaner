# Copy this file and rename it to ".env"

# ---- bot ----
DISCORD_TOKEN=
# 開発用: 指定するとスラッシュコマンドをこのサーバーにのみ登録する（即時反映）
#DEV_GUILD_ID=

# 操作に必要なロール名
ADMIN_ROLE_NAME=message_cleaner_admin

# メッセージ言語 (ja / en)
MESSAGE_LANGUAGE=ja
# ログ言語 (ja / en)
LOG_LANGUAGE=ja
# ログレベル (debug / info / warn / error)
LOG_LEVEL=info

# ---- 削除スケジューラ ----
# DBに削除期限切れのメッセージがあるか確認する周期
SCHEDULER_INTERVAL=1s
# 1周期でDBから取り出す最大件数
CLAIM_BATCH_SIZE=1000
# 取り出したメッセージを他の周期が再取得しないようにする時間
CLAIM_LEASE=2m
# チャンネルごとのメモリ内キュー上限（超えたチャンネルは次周期の取り出し対象外）
CHANNEL_QUEUE_LIMIT=500
# 同時にリクエストを送るチャンネル数
DELETE_WORKERS=8
# 一時的なエラー時の最大試行回数
MAX_DELETE_ATTEMPTS=10
# 権限不足などチャンネル単位のエラーがこの回数連続したら監視を解除する
CHANNEL_FAILURE_LIMIT=3
# チャンネル単位のエラー時、そのチャンネルの削除を保留する時間
CHANNEL_FAILURE_BACKOFF=10m

# ---- Discord API ----
# Bot全体で1秒あたりに送るRESTリクエスト数の上限（Discordのグローバル上限は50）
API_RATE_PER_SECOND=40
API_BURST=10

# ---- 履歴同期 ----
# 監視開始時、既存メッセージを取り込んで削除対象にするか
BACKFILL_ON_ENABLE=true
# 1回の同期でチャンネルごとに取得する最大ページ数（1ページ100件、0は無制限）
SYNC_MAX_PAGES=0
# 同時に同期するチャンネル数
SYNC_CONCURRENCY=2

# /clear で1回に削除予約する最大件数
CLEAR_MAX_MESSAGES=1000
# 確認ダイアログのタイムアウト
CONFIRM_TIMEOUT=10s
